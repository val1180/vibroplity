---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Дополнительная разметка schema.org для страницы */
  jsonLd?: object[];
  /** Хлебные крошки → BreadcrumbList (последняя — текущая страница, без href) */
  crumbs?: { label: string; href?: string }[];
  noindex?: boolean;
}
const { title, description, jsonLd = [], crumbs, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname, SITE.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  description: 'Аренда виброплит 60–500 кг и вибротрамбовок в Минске',
  url: SITE.url,
  image: `${SITE.url}/og.png`,
  openingHours: SITE.openingHours,
  priceRange: 'BYN 20–180 / сутки',
  areaServed: 'Минск',
  address: SITE.points.map((p) => ({
    '@type': 'PostalAddress',
    streetAddress: p.address,
    addressLocality: 'Минск',
    addressCountry: 'BY',
  })),
};
const breadcrumbs = crumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.label,
    item: new URL(c.href ?? Astro.url.pathname, SITE.url).href,
  })),
};
const ld = [business, ...(breadcrumbs ? [breadcrumbs] : []), ...jsonLd];
---
<!doctype html>
<html lang="ru" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#121314" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efe9df" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_BY" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body data-ym={SITE.analytics.metrika || undefined} data-ga={SITE.analytics.ga || undefined}>
    <div class="densbar" aria-hidden="true"><span id="densbar"></span></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <dialog id="leadModal" class="lead-modal dark-zone" aria-labelledby="leadModalTitle">
      <button class="lm-close" type="button" data-close aria-label="Закрыть">×</button>
      <div class="kicker">Бронь</div>
      <h2 id="leadModalTitle">Забронируем плиту и&nbsp;перезвоним</h2>
      <p class="lm-model" id="leadModalModel" hidden></p>
      <LeadForm id="modalForm" source="Всплывающая форма" />
    </dialog>

    <button class="fab" type="button" data-lead aria-label="Оставить заявку">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/></svg>
    </button>

    <script>
      import '../scripts/motion';
      import '../scripts/leads';
      import '../scripts/analytics';
    </script>
  </body>
</html>

<style>
  .densbar { position: fixed; left: 0; right: 0; top: 0; height: 3px; z-index: 100; pointer-events: none; }
  .densbar span { display: block; height: 100%; width: 100%; background: var(--density); transform-origin: 0 50%; transform: scaleX(0); }

  .lead-modal {
    width: min(520px, calc(100% - 32px)); max-height: calc(100% - 32px); margin: auto; padding: 38px 30px 28px;
    border-radius: 24px; border: 1px solid var(--stroke); color: var(--text);
    background: radial-gradient(ellipse at 0% 100%, rgba(176, 138, 90, .3), transparent 55%), var(--bg2);
  }
  .lead-modal::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; background: var(--zebra); }
  .lead-modal::backdrop { background: rgba(8, 8, 8, .72); backdrop-filter: blur(6px); }
  .lead-modal h2 { font-size: 26px; margin-bottom: 18px; }
  .lm-close { position: absolute; right: 12px; top: 12px; width: 40px; height: 40px; border: 0; background: none; font-size: 28px; color: var(--muted); cursor: pointer; }
  .lm-model { margin: -6px 0 16px; padding: 10px 14px; border-radius: 12px; background: var(--accent-soft); border-left: 3px solid var(--signal); font-weight: 700; }

  .fab {
    display: none; position: fixed; right: 16px; bottom: 16px; z-index: 60; border: 0; padding: 0; cursor: pointer;
    width: 58px; height: 58px; border-radius: 50%; place-items: center; color: var(--on-signal);
    background: var(--signal); box-shadow: 0 0 0 0 rgb(var(--signal-rgb) / .55); animation: ring 2.4s infinite;
  }
  @keyframes ring { 70% { box-shadow: 0 0 0 16px rgb(var(--signal-rgb) / 0); } 100% { box-shadow: 0 0 0 0 rgb(var(--signal-rgb) / 0); } }
  @media (max-width: 980px) { .fab { display: grid; } }
</style>
