---
import { SITE } from '../data/site';
const tips = [
  { k: 'H₂O', t: 'Пролейте песок водой', p: 'Сухой песок под плитой «плывёт» и не держит форму. Пролейте до состояния, когда след ботинка не осыпается, — и только потом заводите плиту.' },
  { k: '15–20', t: 'Отсыпайте слоями', p: 'Слой 15–20 см лёгкая и средняя плита пробивают до низа. Отсыпали сразу 50 см — сверху будет плотно, а внизу останется рыхлая подушка, которая сядет через год.' },
  { k: '⇄', t: 'Проходы — внахлёст', p: 'Каждая полоса перекрывает соседнюю на 5–10 см, проходы — крест-накрест. Пропущенная полоса потом проявится ямой под плиткой.' },
  { k: '4–6', t: 'Считайте проходы', p: 'Песку обычно хватает 3–5 проходов, щебню и ПГС — 5–7. Готово, когда плита перестаёт оставлять след и начинает «подпрыгивать».' },
];
---
<section id="tips" class="tp">
  <div class="wrap">
    <div class="kicker reveal">Советы</div>
    <h2 class="reveal">Чтобы основание не просело через сезон</h2>
    <div class="grid">
      {tips.map((t) => (
        <article class="reveal"><span class="k num">{t.k}</span><h3>{t.t}</h3><p>{t.p}</p></article>
      ))}
    </div>
    <p class="winter reveal"><b>Зимой</b> мёрзлый грунт не уплотняется — его сначала отогревают. Для этого берут тепловые пушки: <a href={SITE.teplopushka} target="_blank" rel="noopener">teplopushka.by</a>.</p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 32px; }
  article { padding: 22px 20px; border-radius: var(--r); background: var(--card); border: 1px solid var(--line); }
  .k { display: inline-grid; place-items: center; min-width: 52px; height: 40px; padding: 0 10px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); font-size: 16px; font-weight: 500; margin-bottom: 14px; }
  h3 { font-size: 19px; margin-bottom: 8px; }
  p { color: var(--muted); font-size: 14.5px; }
  .winter { margin-top: 22px; color: var(--muted); }
  .winter b { color: var(--text); }
  .winter a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
