---
import Logo from './Logo.astro';
import { SITE, telHref } from '../data/site';
import { TASK_PAGES } from '../data/pages';

const path = Astro.url.pathname.replace(/\.html$/, '');
---
<header class="hdr">
  <div class="wrap hd">
    <a class="home" href="/" aria-label={`${SITE.name} — на главную`}><Logo /></a>
    <nav id="nav" aria-label="Разделы">
      <a href="/#catalog">Цены</a>
      <a href="/#calc">Калькулятор</a>
      {TASK_PAGES.map((t) => <a class={path === `/${t.slug}` ? 'on' : ''} href={`/${t.slug}.html`}>{t.short}</a>)}
      <a class={path === '/kontakty' ? 'on' : ''} href="/kontakty.html">Контакты</a>
      <a class="nav-phone" href={telHref}>{SITE.phoneHuman}</a>
    </nav>
    <div class="hd-right">
      <a class="phone num" href={telHref}>{SITE.phoneHuman}</a>
      <button class="btn" type="button" data-lead>Забронировать</button>
      <button class="burger" type="button" aria-label="Меню" aria-controls="nav" aria-expanded="false"><span></span></button>
    </div>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  const nav = document.getElementById('nav')!;
  const toggle = (open: boolean) => {
    nav.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger.addEventListener('click', () => toggle(!nav.classList.contains('open')));
  nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) toggle(false); });
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); }
  /* Размытие — на подложке: в Safari backdrop-filter на самой шапке ломает position: fixed меню */
  .hdr::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--header-bg); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .home { flex: none; }
  .hd { display: flex; align-items: center; gap: 26px; height: 66px; }
  nav { display: flex; gap: 20px; font-weight: 600; font-size: 15px; color: var(--muted); }
  nav a { transition: color .15s; white-space: nowrap; }
  nav a:hover, nav a.on { color: var(--text); }
  nav .on { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 7px; text-decoration-thickness: 3px; }
  .nav-phone { display: none; }
  .hd-right { margin-left: auto; display: flex; gap: 14px; align-items: center; }
  .phone { font-weight: 500; font-size: 15px; white-space: nowrap; }
  .hd-right .btn { padding: 11px 18px; }
  .burger { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line); background: none; cursor: pointer; position: relative; }
  .burger span, .burger span::before, .burger span::after { position: absolute; left: 12px; width: 20px; height: 2px; background: var(--text); border-radius: 2px; transition: transform .2s; }
  .burger span { top: 21px; }
  .burger span::before { content: ''; left: 0; top: -6px; }
  .burger span::after { content: ''; left: 0; top: 6px; }
  .burger[aria-expanded='true'] span { background: transparent; }
  .burger[aria-expanded='true'] span::before { transform: translateY(6px) rotate(45deg); }
  .burger[aria-expanded='true'] span::after { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 1180px) {
    .hd { gap: 12px; }
    .hd-right .btn { display: none; }
    .burger { display: block; }
    nav {
      position: fixed; inset: 66px 0 0; flex-direction: column; gap: 0; padding: 12px 20px 40px;
      background: var(--bg); font: 800 24px var(--display); color: var(--text);
      transform: translateX(100%); visibility: hidden; transition: transform .3s, visibility .3s; overflow-y: auto;
    }
    nav.open { transform: none; visibility: visible; }
    nav a { padding: 15px 0; border-bottom: 1px solid var(--line); }
    .nav-phone { display: block; color: var(--accent); border: 0; }
  }
  @media (max-width: 400px) { .phone { display: none; } }
</style>
